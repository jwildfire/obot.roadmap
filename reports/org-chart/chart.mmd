%%{init: {"theme": "neutral"}}%%
flowchart TD
  JW["@jwildfire — chief executive"]
  subgraph NAMED["the named roles — pinned"]
    P["🎩🤖 obot-prime — the concierge"]
    N["🧭🤖 obot-navigator — operating officer"]
    F["⚓🤖 admiral — triggered, no rank over N"]
  end
  subgraph CREW["the crew — dispatched per requirement"]
    W["👯🤖 workers — W0001 onward"]
    S["subagents + forks — roll up to the parent"]
  end
  SW["the sweep — a script, not an agent"]
  LD["macOS launchd"]

  P -- answers to --> JW
  N -- reports to --> P
  F -- reports findings to --> N
  W -- judged at closeout by --> N
  S -- attributed to --> W

  JW -. asks .-> P
  P -. hands each ask to .-> N
  N -. dispatches, requirement first .-> W
  W -. spawn .-> S
  SW -. wakes on a detection .-> N
  SW -. launches on a positive condition .-> F
  LD -. fires every 5 minutes .-> SW

  classDef notagent stroke-dasharray:6 3;
  class SW,LD notagent;
  classDef human stroke-width:2px;
  class JW human;
